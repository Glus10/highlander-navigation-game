# Non-secret build-time configuration (Vite exposes VITE_* to the browser bundle).
# Copy to .env to override locally. Never put secrets here: everything below ships to the browser.
# Consumed and validated by src/app/config (Phase 3).

# Routing (hosted FOSSGIS OSRM, foot profile; usage policy: max 1 request/second)
VITE_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
VITE_ROUTING_TIMEOUT_MS=8000

# Goal generation
VITE_GOAL_MIN_RADIUS_M=300
VITE_GOAL_MAX_RADIUS_M=800
VITE_MAX_SNAP_DISTANCE_M=150
VITE_MAX_ROUTE_LENGTH_M=1600
VITE_MAX_GOAL_ATTEMPTS=5

# Goal detection
VITE_GOAL_THRESHOLD_M=25

# Location
VITE_START_FIX_MAX_ACCURACY_M=100
VITE_START_FIX_WAIT_MS=10000
VITE_GEOLOCATION_TIMEOUT_MS=15000

# Simulation mode (?simulate=1) default start position, used when no lat/lng URL params are given
VITE_SIM_START_LAT=51.5080
VITE_SIM_START_LNG=-0.1281
